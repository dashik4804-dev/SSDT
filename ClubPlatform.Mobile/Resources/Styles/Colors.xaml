<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================================= -->
    <!-- ФИРМЕННЫЕ ЦВЕТА ПРИЛОЖЕНИЯ "СВОИ ЛЮДИ" -->
    <!-- ========================================= -->

    <!-- Основные цвета -->
    <Color x:Key="Primary">#6235F5</Color>
    <Color x:Key="PrimaryDark">#2512C9</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <Color x:Key="Secondary">#E8E2FF</Color>
    <Color x:Key="SecondaryDarkText">#D7C8FF</Color>
    <Color x:Key="Tertiary">#F22CB5</Color>

    <!-- Дополнительные яркие цвета -->
    <Color x:Key="BrandBlue">#2512C9</Color>
    <Color x:Key="BrandPurple">#6235F5</Color>
    <Color x:Key="BrandPink">#F22CB5</Color>
    <Color x:Key="BrandCyan">#05BEEA</Color>
    <Color x:Key="BrandOrange">#FF9B43</Color>

    <!-- Фоны и текст -->
    <Color x:Key="AppBackground">#F7F5FF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="AppText">#292344</Color>
    <Color x:Key="AppTextSecondary">#746D8A</Color>
    <Color x:Key="AppBorder">#E8E2FA</Color>

    <!-- Светлые оттенки для категорий -->
    <Color x:Key="LightPurple">#EEE8FF</Color>
    <Color x:Key="LightPink">#FFE3F5</Color>
    <Color x:Key="LightCyan">#DDF7FF</Color>
    <Color x:Key="LightOrange">#FFF0DF</Color>

    <!-- Цвета статусов -->
    <Color x:Key="SuccessColor">#18875A</Color>
    <Color x:Key="WarningColor">#B66B12</Color>
    <Color x:Key="ErrorColor">#C93655</Color>

    <!-- Существующие системные цвета -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#F22CB5</Color>
    <Color x:Key="MidnightBlue">#2512C9</Color>
    <Color x:Key="OffBlack">#1F1B30</Color>

    <!-- Серые оттенки -->
    <Color x:Key="Gray100">#F0EDF8</Color>
    <Color x:Key="Gray200">#E8E2FA</Color>
    <Color x:Key="Gray300">#C6BFD8</Color>
    <Color x:Key="Gray400">#A39CB8</Color>
    <Color x:Key="Gray500">#746D8A</Color>
    <Color x:Key="Gray600">#514B68</Color>
    <Color x:Key="Gray900">#292344</Color>
    <Color x:Key="Gray950">#1F1B30</Color>

    <!-- Кисти основных цветов -->
    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{StaticResource Primary}" />

    <SolidColorBrush
        x:Key="SecondaryBrush"
        Color="{StaticResource Secondary}" />

    <SolidColorBrush
        x:Key="TertiaryBrush"
        Color="{StaticResource Tertiary}" />

    <SolidColorBrush
        x:Key="WhiteBrush"
        Color="{StaticResource White}" />

    <SolidColorBrush
        x:Key="BlackBrush"
        Color="{StaticResource Black}" />

    <!-- Кисти фирменных цветов -->
    <SolidColorBrush
        x:Key="BrandBlueBrush"
        Color="{StaticResource BrandBlue}" />

    <SolidColorBrush
        x:Key="BrandPurpleBrush"
        Color="{StaticResource BrandPurple}" />

    <SolidColorBrush
        x:Key="BrandPinkBrush"
        Color="{StaticResource BrandPink}" />

    <SolidColorBrush
        x:Key="BrandCyanBrush"
        Color="{StaticResource BrandCyan}" />

    <SolidColorBrush
        x:Key="AppBackgroundBrush"
        Color="{StaticResource AppBackground}" />

    <SolidColorBrush
        x:Key="CardBackgroundBrush"
        Color="{StaticResource CardBackground}" />

    <!-- Кисти серых оттенков -->
    <SolidColorBrush x:Key="Gray100Brush"
                     Color="{StaticResource Gray100}" />

    <SolidColorBrush x:Key="Gray200Brush"
                     Color="{StaticResource Gray200}" />

    <SolidColorBrush x:Key="Gray300Brush"
                     Color="{StaticResource Gray300}" />

    <SolidColorBrush x:Key="Gray400Brush"
                     Color="{StaticResource Gray400}" />

    <SolidColorBrush x:Key="Gray500Brush"
                     Color="{StaticResource Gray500}" />

    <SolidColorBrush x:Key="Gray600Brush"
                     Color="{StaticResource Gray600}" />

    <SolidColorBrush x:Key="Gray900Brush"
                     Color="{StaticResource Gray900}" />

    <SolidColorBrush x:Key="Gray950Brush"
                     Color="{StaticResource Gray950}" />

</ResourceDictionary>

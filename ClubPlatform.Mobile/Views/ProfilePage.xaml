<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ClubPlatform.Mobile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профиль"
    BackgroundColor="{StaticResource AppBackground}"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- ================================== -->
            <!-- ЯРКАЯ ШАПКА ПРОФИЛЯ -->
            <!-- ================================== -->

            <Grid HeightRequest="300">

                <Grid.Background>
                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="1,1">

                        <GradientStop
                            Color="{StaticResource BrandBlue}"
                            Offset="0" />

                        <GradientStop
                            Color="{StaticResource BrandPurple}"
                            Offset="0.65" />

                        <GradientStop
                            Color="{StaticResource BrandPink}"
                            Offset="1" />

                    </LinearGradientBrush>
                </Grid.Background>

                <VerticalStackLayout
                    Padding="24,24,24,20"
                    Spacing="12"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        Text="✨ СВОИ ЛЮДИ"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <!-- Фото пользователя -->
                    <Border
                        WidthRequest="136"
                        HeightRequest="136"
                        HorizontalOptions="Center"
                        Stroke="White"
                        StrokeThickness="4"
                        StrokeShape="RoundRectangle 68"
                        BackgroundColor="#E8E2FA"
                        Padding="0">

                        <Image
                            x:Name="ProfilePhoto"
                            Aspect="AspectFill"
                            BackgroundColor="#E8E2FA" />

                    </Border>

                    <!-- Имя -->
                    <Label
                        x:Name="NameLabel"
                        Text="Загрузка профиля..."
                        FontSize="26"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="White" />

                    <!-- Роль -->
                    <Border
                        BackgroundColor="#5534D5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="14,7"
                        HorizontalOptions="Center">

                        <Label
                            x:Name="RoleLabel"
                            FontSize="13"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="White" />

                    </Border>

                </VerticalStackLayout>

            </Grid>

            <!-- ================================== -->
            <!-- ОСНОВНОЕ СОДЕРЖИМОЕ -->
            <!-- ================================== -->

            <VerticalStackLayout
                Padding="20,24,20,30"
                Spacing="18">

                <!-- Личная информация -->
                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            Text="👤 Личная информация"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandBlue}" />

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource AppBorder}" />

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Электронная почта"
                                FontSize="12"
                                TextColor="{StaticResource AppTextSecondary}" />

                            <Label
                                x:Name="EmailLabel"
                                FontSize="16"
                                TextColor="{StaticResource AppText}" />

                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Возраст"
                                    FontSize="12"
                                    TextColor="{StaticResource AppTextSecondary}" />

                                <Label
                                    x:Name="AgeLabel"
                                    FontSize="16"
                                    TextColor="{StaticResource AppText}" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4">

                                <Label
                                    Text="Пол"
                                    FontSize="12"
                                    TextColor="{StaticResource AppTextSecondary}" />

                                <Label
                                    x:Name="GenderLabel"
                                    FontSize="16"
                                    TextColor="{StaticResource AppText}" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Статус загрузки профиля -->
                <Label
                    x:Name="StatusLabel"
                    Text="Получаем данные..."
                    FontSize="12"
                    TextColor="{StaticResource AppTextSecondary}" />

                <!-- ================================== -->
                <!-- МОИ КЛУБЫ -->
                <!-- ================================== -->

                <VerticalStackLayout
                    x:Name="MyClubsSection"
                    Spacing="12">

                    <Label
                        Text="💜 Мои клубы"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandBlue}" />

                    <Label
                        x:Name="MyClubsEmptyLabel"
                        Text="Ты пока не состоишь ни в одном клубе."
                        FontSize="14"
                        TextColor="{StaticResource AppTextSecondary}"
                        IsVisible="False" />

                    <VerticalStackLayout
                        x:Name="MyClubsLayout"
                        Spacing="12" />

                    <ActivityIndicator
                        x:Name="MyClubsLoadingIndicator"
                        IsRunning="False"
                        IsVisible="False"
                        Color="{StaticResource BrandPurple}" />

                </VerticalStackLayout>

                <!-- ================================== -->
                <!-- АДМИНИСТРАТИВНАЯ ПАНЕЛЬ -->
                <!-- ================================== -->

                <Button
                    x:Name="AdminPanelButton"
                    Text="⚙ Панель администратора"
                    HeightRequest="54"
                    BackgroundColor="{StaticResource BrandBlue}"
                    TextColor="White"
                    CornerRadius="16"
                    IsVisible="False"
                    Clicked="OnAdminPanelClicked" />

                <!-- ================================== -->
                <!-- РЕДАКТИРОВАНИЕ ПРОФИЛЯ -->
                <!-- ================================== -->

                <Button
                    Text="✏️ Редактировать профиль"
                    HeightRequest="54"
                    BackgroundColor="{StaticResource BrandPurple}"
                    TextColor="White"
                    CornerRadius="16"
                    Clicked="OnEditProfileClicked" />

                <!-- ================================== -->
                <!-- ОБРАЩЕНИЯ И ЖАЛОБЫ -->
                <!-- ================================== -->

                <VerticalStackLayout
                    x:Name="UserActionsSection"
                    Spacing="12">

                    <Label
                        Text="✨ Помощь и обращения"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandBlue}" />


                    <Button
                        Text="💬 Написать в поддержку"
                        Clicked="OnCreateSupportTicketClicked"
                        BackgroundColor="#DDF7FF"
                        TextColor="#087CA3"
                        CornerRadius="16"
                        HeightRequest="52" />


                    <Button
                        Text="📨 Мои обращения"
                        Clicked="OnMySupportTicketsClicked"
                        BackgroundColor="{StaticResource LightPurple}"
                        TextColor="{StaticResource BrandPurple}"
                        CornerRadius="16"
                        HeightRequest="52" />

                    <Button
                        Text="🚩 Мои жалобы"
                        Clicked="OnMyReportsClicked"
                        BackgroundColor="{StaticResource LightPink}"
                        TextColor="#A91A79"
                        CornerRadius="16"
                        HeightRequest="52" />

                </VerticalStackLayout>

                <!-- ================================== -->
                <!-- ВЫХОД ИЗ АККАУНТА -->
                <!-- ================================== -->


                <Button
                    Text="🚪 Выйти из аккаунта"
                    HeightRequest="52"
                    BackgroundColor="#E53950"
                    TextColor="White"
                    CornerRadius="16"
                    BorderWidth="0"
                    Clicked="OnLogoutClicked" />


            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ClubPlatform.Mobile.Views.Clubs.ClubDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="О клубе"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- ================================= -->
            <!-- ФОТОГРАФИЯ КЛУБА -->
            <!-- ================================= -->

            <Grid HeightRequest="230">

                <Grid.Background>
                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="1,1">

                        <GradientStop
                            Color="{StaticResource BrandBlue}"
                            Offset="0" />

                        <GradientStop
                            Color="{StaticResource BrandPurple}"
                            Offset="0.65" />

                        <GradientStop
                            Color="{StaticResource BrandPink}"
                            Offset="1" />

                    </LinearGradientBrush>
                </Grid.Background>

                <Image
                    x:Name="ClubPhoto"
                    Aspect="AspectFill"
                    BackgroundColor="Transparent" />

            </Grid>

            <!-- ================================= -->
            <!-- ОСНОВНАЯ ИНФОРМАЦИЯ -->
            <!-- ================================= -->

            <VerticalStackLayout
                Padding="20,22,20,30"
                Spacing="16">

                <!-- Название -->
                <Label
                    x:Name="NameLabel"
                    FontSize="27"
                    FontAttributes="Bold"
                    TextColor="{StaticResource BrandBlue}"
                    LineBreakMode="WordWrap" />

                <!-- Количество участников -->
                <Border
                    BackgroundColor="{StaticResource LightPurple}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10"
                    HorizontalOptions="Start">

                    <HorizontalStackLayout Spacing="8">

                        <Label
                            Text="👥"
                            FontSize="17" />

                        <Label
                            x:Name="MembersLabel"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandPurple}"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </Border>

                <!-- Адрес -->
                <Border
                    BackgroundColor="{StaticResource LightCyan}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="12,10">

                    <HorizontalStackLayout Spacing="8">

                        <Label
                            Text="📍"
                            FontSize="17" />

                        <Label
                            x:Name="AddressLabel"
                            FontSize="14"
                            TextColor="#087CA3"
                            VerticalOptions="Center"
                            LineBreakMode="WordWrap"
                            HorizontalOptions="FillAndExpand" />

                    </HorizontalStackLayout>

                </Border>

                <!-- ================================= -->
                <!-- ОПИСАНИЕ КЛУБА -->
                <!-- ================================= -->

                <Border
                    BackgroundColor="White"
                    Stroke="{StaticResource AppBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="✨ О клубе"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource BrandBlue}" />

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource AppBorder}" />

                        <Label
                            x:Name="DescriptionLabel"
                            FontSize="15"
                            TextColor="{StaticResource AppText}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <!-- ================================= -->
                <!-- ИНТЕРЕСЫ -->
                <!-- ================================= -->

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="💖 Интересы клуба"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandBlue}" />

                    <Border
                        BackgroundColor="{StaticResource LightPink}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12">

                        <Label
                            x:Name="InterestsLabel"
                            FontSize="14"
                            TextColor="#A91A79"
                            LineBreakMode="WordWrap" />

                    </Border>

                </VerticalStackLayout>

                <!-- ================================= -->
                <!-- КОНТАКТЫ -->
                <!-- ================================= -->

                <VerticalStackLayout
                    x:Name="ContactLayout"
                    IsVisible="False"
                    Spacing="10">

                    <Label
                        Text="📞 Контакты"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource BrandBlue}" />

                    <Border
                        BackgroundColor="White"
                        Stroke="{StaticResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">

                        <VerticalStackLayout Spacing="10">

                            <Label
                                x:Name="PhoneLabel"
                                FontSize="14"
                                TextColor="{StaticResource AppText}" />

                            <Label
                                x:Name="EmailLabel"
                                FontSize="14"
                                TextColor="{StaticResource AppText}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

                <!-- ================================= -->
                <!-- ДЕЙСТВИЯ С КЛУБОМ -->
                <!-- ================================= -->

                <Label
                    Text="✨ Действия"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="{StaticResource BrandBlue}" />

                <!-- Вступление -->
                <Button
                    x:Name="JoinButton"
                    Text="💜 Вступить в клуб"
                    HeightRequest="54"
                    BackgroundColor="{StaticResource BrandPurple}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    Clicked="OnJoinClicked" />

                <!-- Чат -->
                <Button
                    x:Name="ChatButton"
                    Text="💬 Открыть чат"
                    HeightRequest="52"
                    BackgroundColor="{StaticResource LightCyan}"
                    TextColor="#087CA3"
                    CornerRadius="16"
                    Clicked="OnChatClicked" />

                <!-- Участники -->
                <Button
                    x:Name="MembersButton"
                    Text="👥 Участники клуба"
                    HeightRequest="52"
                    BackgroundColor="{StaticResource LightPurple}"
                    TextColor="{StaticResource BrandPurple}"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    IsVisible="True"
                    Clicked="OnMembersClicked" />

                <!-- Выход из клуба -->
                <Button
                    x:Name="LeaveButton"
                    Text="Выйти из клуба"
                    HeightRequest="52"
                    BackgroundColor="#FFE3E8"
                    TextColor="#C93655"
                    CornerRadius="16"
                    IsVisible="False"
                    Clicked="OnLeaveClicked" />

                <!-- Обновление информации -->
                <Button
                    Text="↻ Обновить информацию"
                    HeightRequest="48"
                    BackgroundColor="White"
                    TextColor="{StaticResource BrandPurple}"
                    BorderColor="{StaticResource AppBorder}"
                    BorderWidth="1"
                    CornerRadius="16"
                    Clicked="OnRefreshClicked" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
